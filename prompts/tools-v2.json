          "resource"
        ],
        "title": "HistoryArgs",
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_hypothesis",
      "description": "Validate a STATE value or IDENTITY subject against cited source. RELATIONSHIP uses an explicit system/resource dependency key. For prose READBACK notes, supply the exact source sentence in quote; the source contract must support it. Rejected hypotheses must not be reported as facts.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "system": {
            "maxLength": 120,
            "minLength": 1,
            "title": "System",
            "type": "string"
          },
          "resource": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Resource",
            "type": "string"
          },
          "evidence_id": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Evidence Id",
            "type": "string"
          },
          "claim": {
            "enum": [
              "STATE",
              "IDENTITY",
              "RELATIONSHIP"
            ],
            "title": "Claim",
            "type": "string"
          },
          "value": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Value",
            "type": "string"
          },
          "quote": {
            "default": "",
            "description": "For a resource_readback_note, copy the exact Resource ... Observed state: ... sentence from note. Otherwise use empty string.",
            "maxLength": 1000,
            "title": "Quote",
            "type": "string"
          }
        },
        "required": [
          "system",
          "resource",
          "evidence_id",
          "claim",
          "value"
        ],
        "title": "ProposalArgs",
        "type": "object"
      }
    }
  }
]
