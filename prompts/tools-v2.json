      "parameters": {
        "additionalProperties": false,
        "properties": {
          "system": {
            "maxLength": 120,
            "minLength": 1,
            "title": "System",
            "type": "string"
          },
          "resource": {
            "maxLength": 120,
            "minLength": 1,
