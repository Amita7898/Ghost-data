        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search_evidence",
      "description": "Search eligible subject-linked observations matching ANY query token. Query may be empty. Paginate 8 at a time.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "default": "",
            "maxLength": 120,
            "title": "Query",
            "type": "string"
          },
          "offset": {
            "default": 0,
            "maximum": 10000,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          }
        },
        "title": "SearchArgs",
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "read_evidence",
      "description": "Read one registered eligible observation and its exact source locator.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Evidence Id",
            "type": "string"
          }
        },
        "required": [
          "evidence_id"
        ],
        "title": "ReadArgs",
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "resolve_identity",
